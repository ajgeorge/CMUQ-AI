# Copy this file to .env and fill in the values.
#   cp .env.example .env
# Never commit your .env file — it contains your API key.
# After filling it in, run `npm run check:ai` to confirm the connection works.

# --- AI connection (any OpenAI-compatible API) ---
# Default: Groq (free tier). Create a key at https://console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=

# Model used by the AI Client (role-plays the bank customer). A fast model keeps the chat natural.
CLIENT_MODEL=qwen/qwen3.8-27b
# Model used by the AI Coach (reviews the interview). Must support JSON output.
# Can be the same as CLIENT_MODEL.
COACH_MODEL=openai/gpt-oss-120b

# Optional: how much a reasoning model (e.g. gpt-oss) "thinks" before answering:
# low, medium or high. Leave empty for models that don't reason, or to use the default.
# Lower effort means faster replies and fewer tokens used.
CLIENT_REASONING_EFFORT=
COACH_REASONING_EFFORT=

# Optional backup models, used when the main model is rate-limited, over its limits, too slow
# or down. On Groq each model has its own usage limits, so a backup keeps the app working
# when the main model's free allowance runs out. Leave empty for no backup.
# gpt-oss-20b is a good coach backup; as a client it is a little less natural than qwen,
# but better than an error in the middle of an interview.
CLIENT_FALLBACK_MODEL=openai/gpt-oss-20b
COACH_FALLBACK_MODEL=openai/gpt-oss-20b
# gpt-oss-20b needs "low" as the client backup, so it doesn't spend its short reply limit thinking.
CLIENT_FALLBACK_REASONING_EFFORT=low
COACH_FALLBACK_REASONING_EFFORT=

# Maximum time to wait for one AI response, in milliseconds.
# Failed or timed-out requests are retried up to 2 times. With a backup model set, the app
# switches to the backup straight away instead of retrying the main model.
AI_TIMEOUT_MS=30000

# --- Server ---
PORT=3001
